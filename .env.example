# PHANTOM — Environment variables
# Copy this to .env and fill in real values. Never commit .env.

# === Postgres ===
POSTGRES_USER=phantom
POSTGRES_PASSWORD=phantom_dev_pw
POSTGRES_DB=phantom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# When running backend INSIDE docker, override POSTGRES_HOST=postgres in compose

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=phantom_dev_pw
# In docker, NEO4J_URI=bolt://neo4j:7687

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# In docker, swap localhost for redis

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENV=development

# === Frontend / CORS ===
FRONTEND_URL=http://localhost:5173

# === ML model caches ===
# These point to the pre-downloaded model directory.
# On host: relative to project root. In docker: /app/models (mounted).
TRANSFORMERS_CACHE=./models
SENTENCE_TRANSFORMERS_HOME=./models
HF_HUB_OFFLINE=1

# === Optional: Gemini for narrative report (Phase 2) ===
# Leave blank to use built-in f-string template (default, demo-safe).
GEMINI_API_KEY=

# === Crypto ===
# Path where Ed25519 keypair is stored (auto-generated on first run).
PHANTOM_KEY_DIR=./keys
